GNANI_API_KEY=
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER is also accepted as a legacy key variable.
# For another provider, set LLM_PROVIDER=compatible and the three fields below.
# Optional: hosted chat-completions-compatible reasoning provider.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Without these, the UI clearly uses limited, deterministic knowledge lookup.
DATABASE_URL=sqlite:///./data/awaazdesk.db
# Local-only single-business MVP. Do not expose publicly without authentication.
OPENROUTER=
