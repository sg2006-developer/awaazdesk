# Gnani speech: Prisma v3.0 (STT) + Timbre (TTS)
GNANI_API_KEY=

# Reasoning (OpenRouter by default)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# For another OpenAI-compatible provider instead:
# LLM_PROVIDER=compatible
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

DATABASE_URL=sqlite:///./data/awaazdesk.db

# Hosted demo protection. Empty access code = open (local development).
DEMO_ACCESS_CODE=
# SESSION_SECRET=            # set a long random value when hosting
# CALLS_PER_HOUR_PER_VISITOR=10
# SPEECH_REQUESTS_PER_MINUTE=20
# DAILY_CALL_LIMIT=150
# DAILY_LLM_LIMIT=800
# MAX_LIVE_CALLS=4
# MAX_CALL_SECONDS=300
# GNANI_STT_CONCURRENCY=2
# GNANI_TTS_CONCURRENCY=2
